// SentraRMM — Remote Management & Monitoring Platform
// SQLite via Prisma. Note: SQLite + Prisma does not support scalar lists,
// so all collection-like fields are stored as JSON strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Devices ─────────────────────────────

model Device {
  id             String    @id @default(cuid())
  agentId        String    @unique // stable id generated by the agent on first run
  hostname       String
  friendlyName   String? // e.g. "Work Laptop"
  osName         String // "Windows 11 Pro"
  osVersion      String // "10.0.26100 build 26100"
  osArch         String // "x64" / "arm64"
  platform       String // "win32"
  cpuModel       String?
  cpuCores       Int       @default(0)
  totalMemoryMB  Int       @default(0)
  ipAddress      String? // public IP as seen by hub
  localIp        String? // primary LAN ip
  macAddress     String?
  agentVersion   String?
  deviceType     String    @default("workstation") // workstation | laptop | server
  tags           String? // JSON string array
  status         String    @default("offline") // online | offline
  lastSeen       DateTime?
  firstSeen      DateTime  @default(now())
  locationLat    Float?
  locationLon    Float?
  locationLabel  String? // "Manzini, SZ" etc
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  commands         CommandExecution[]
  mediaAssets      MediaAsset[]
  networkCaptures  NetworkCapture[]
  locationPings    LocationPing[]
  fileOperations   FileOperation[]
  processSnapshots ProcessSnapshot[]
}

// ───────────────────────── Command execution ────────────────────────

model CommandExecution {
  id          String    @id @default(cuid())
  deviceId    String
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  command     String
  output      String?
  status      String    @default("pending") // pending | running | completed | failed | timeout
  exitCode    Int?
  durationMs  Int?
  shell       String    @default("powershell")
  createdBy   String    @default("admin")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([deviceId, createdAt])
}

// ─────────────────────────── Media assets ───────────────────────────

model MediaAsset {
  id             String    @id @default(cuid())
  deviceId       String
  device         Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind           String // screenshot | screen_record | mic_record | camera_stream | call
  status         String    @default("requested") // requested | capturing | processing | available | failed | stopped
  format         String? // png | webm | mp4 | wav
  quality        String? // 480p | 720p | 1080p | source
  withMic        Boolean   @default(false)
  durationSec    Int? // 0 / null = indefinite
  sizeBytes      Int?
  encrypted      Boolean   @default(true)
  encryptionNote String? // e.g. "AES-256-GCM, dashboard-set password"
  inMemory       Boolean   @default(true) // executed without dropping files when true
  dataRef        String? // data URI (demo) or object URL for preview
  error          String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([deviceId, createdAt])
}

// ────────────────────────── Network capture ─────────────────────────

model NetworkCapture {
  id            String    @id @default(cuid())
  deviceId      String
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status        String    @default("idle") // running | stopped | failed
  iface         String    @default("any")
  filterBpf     String? // e.g. "tcp port 443"
  tool          String    @default("tshark")
  packets       Int       @default(0)
  bytesCaptured Int       @default(0)
  outputPath    String? // encrypted pcapng path on agent
  encrypted     Boolean   @default(true)
  notes         String?
  startedAt     DateTime  @default(now())
  stoppedAt     DateTime?

  @@index([deviceId, startedAt])
}

// ─────────────────────────── Location pings ─────────────────────────

model LocationPing {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  lat        Float
  lon        Float
  accuracyM  Int?
  label      String?
  source     String   @default("ip") // ip | gps | wifi
  createdAt  DateTime @default(now())

  @@index([deviceId, createdAt])
}

// ─────────────────────────── File operations ────────────────────────

model FileOperation {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  op        String // list | download | upload | delete | rename | modify | mkdir
  path      String
  details   String?
  status    String   @default("ok") // ok | failed
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

// ────────────────────────── Process snapshots ───────────────────────

model ProcessSnapshot {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  data       String // JSON array of process rows
  procCount  Int      @default(0)
  capturedAt DateTime @default(now())

  @@index([deviceId, capturedAt])
}

// ─────────────────────────── Alerts & audit ─────────────────────────

model Alert {
  id           String    @id @default(cuid())
  deviceId     String?
  title        String
  message      String
  severity     String    @default("info") // info | warning | critical
  acknowledged Boolean   @default(false)
  ackedBy      String?
  acknowledgedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([acknowledged, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  deviceId  String?
  actor     String   @default("admin")
  action    String // e.g. "command.exec", "file.delete", "capture.start"
  detail    String?
  severity  String   @default("info") // info | warning | critical
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────── Settings & misc ────────────────────────

model Setting {
  key        String   @id
  value      String // JSON-encoded value
  updatedAt  DateTime @updatedAt
}

model SavedCommand {
  id          String   @id @default(cuid())
  name        String
  command     String
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now())
}
